<?xml version="1.0" encoding="utf-8"?>
<!-- PdfCraft for Android: a NativeActivity that loads libpdfcraft_android.so
     (apps/pdfcraft-android); its subclass PdfCraftActivity (java/) only keeps the latest intent.
     Built by build-apk.sh. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ai.storyteller.pdfcraft">

    <!-- The in-app file picker browses shared storage by path (see android_picker.rs); granted
         once in Settings ▸ Apps ▸ ⋮ ▸ Special access ▸ All files access (the picker opens it). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="PdfCraft"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:resizeableActivity="true"
        android:appCategory="productivity">

        <!-- configChanges: attaching the keyboard cover, rotating, or resizing in split screen
             must not recreate the activity (that would restart the app and its event loop). -->
        <activity
            android:name="ai.storyteller.pdfcraft.PdfCraftActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density|uiMode|fontScale|locale|layoutDirection">
            <meta-data android:name="android.app.lib_name" android:value="pdfcraft_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Open with PdfCraft, and PdfCraft as the default PDF viewer (incoming.rs). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>
    </application>
</manifest>
